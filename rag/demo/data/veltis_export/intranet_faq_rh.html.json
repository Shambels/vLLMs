      "content_layer": "body",
      "label": "section_header",
      "prov": [],
      "orig": "Comment demander un cong\u00e9 ?",
      "text": "Comment demander un cong\u00e9 ?",
      "level": 2
    },
    {
      "self_ref": "#/texts/13",
      "parent": {
        "$ref": "#/texts/12"
      },
      "children": [],
      "content_layer": "body",
      "label": "text",
      "prov": [],
      "orig": "Les cong\u00e9s se demandent dans le portail MonVeltis au moins deux semaines \u00e0 l'avance. Votre manager valide la demande dans le portail.",
      "text": "Les cong\u00e9s se demandent dans le portail MonVeltis au moins deux semaines \u00e0 l'avance. Votre manager valide la demande dans le portail."
    },
